# =====================================================================
# SynthGuard — Enterprise Configuration & Database Connection Settings
# =====================================================================

# Application Environment (demo | enterprise | staging | production)
SYNTHGUARD_ENV=demo

# Local Agent Configuration
SYNTHGUARD_AGENT_NAME=NovaBank-Local-Agent-01
SYNTHGUARD_AGENT_PORT=8000
SYNTHGUARD_VPC_ENCLAVE_MODE=true

# Database Connection (PostgreSQL)
# In Demo Mode: If PostgreSQL is not available, SynthGuard falls back gracefully to local enclave storage.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/novabank_demo
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=novabank_demo
PG_USER=postgres
PG_PASSWORD=postgres

# Privacy Engine & Differential Privacy Budget Defaults
DEFAULT_EPSILON=1.0
DEFAULT_DELTA=0.0
MAX_RECOMMENDED_EPSILON=5.0

# Storage Locations
SYNTHGUARD_STORAGE_DIR=./storage
SYNTHGUARD_AUDIT_LOG_ENABLED=true
